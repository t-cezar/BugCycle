@{
    ViewData["Title"] = "BugCycle";
}

<div class="landing">
    <div class="landing-content">
        <span class="landing-eyebrow">Urmarire de issue-uri pentru echipe mici</span>
        <h1>Vezi clar la ce lucreaza echipa ta.</h1>
        <p>
            BugCycle organizeaza munca in proiecte, sprinturi si un board kanban cu
            drag and drop. Fiecare proiect are propriii membri si propriile roluri,
            asa ca fiecare vede exact ce il priveste.
        </p>

        <div class="landing-actions">
            <a class="btn btn-primary btn-lg" asp-controller="Account" asp-action="Register">
                Creeaza cont
            </a>
            <a class="btn btn-outline-secondary btn-lg" asp-controller="Account" asp-action="Login">
                Am deja cont
            </a>
        </div>

    </div>

    <div class="landing-preview">
        <div class="preview-column">
            <span class="preview-column-title">To Do</span>
            <div class="preview-card"><span class="type-chip type-bug">B</span> Ordinea cardurilor</div>
            <div class="preview-card"><span class="type-chip type-story">S</span> Export CSV</div>
        </div>
        <div class="preview-column">
            <span class="preview-column-title">In Progress</span>
            <div class="preview-card"><span class="type-chip type-task">T</span> Refactor servicii</div>
        </div>
        <div class="preview-column">
            <span class="preview-column-title">Done</span>
            <div class="preview-card"><span class="type-chip type-bug">B</span> Permisiuni board</div>
        </div>
    </div>
</div>
