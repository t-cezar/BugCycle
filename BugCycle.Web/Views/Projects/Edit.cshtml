@model SaveProjectDto
@{
    ViewData["Title"] = "Setari proiect";
    var projectId = (int)(ViewData["ProjectId"] ?? 0);
    var isArchived = ViewData["IsArchived"] as bool? ?? false;
}

<div class="form-shell">
    <div class="card-panel">
        <h1>Setari proiect</h1>
        <p class="text-muted">
            Schimbarea prefixului afecteaza doar afisarea; numerele issue-urilor
            existente nu se schimba.
        </p>

        <form asp-action="Edit" asp-route-id="@projectId" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="Key" class="form-label"></label>
                    <input asp-for="Key" class="form-control text-uppercase" />
                    <span asp-validation-for="Key" class="field-error"></span>
                </div>

                <div class="col-md-8">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="field-error"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Description" class="field-error"></span>
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Salveaza</button>
                <a class="btn btn-outline-secondary" asp-action="Backlog" asp-route-id="@projectId">
                    Renunta
                </a>
            </div>
        </form>
    </div>

    <div class="card-panel mt-4 danger-panel">
        <h2 class="panel-title">Arhivare</h2>
        <p class="text-muted">
            Un proiect arhivat ramane vizibil si consultabil, dar nu mai accepta
            issue-uri sau sprinturi noi. Este alternativa reversibila la stergere.
        </p>

        <form asp-action="Archive" asp-route-id="@projectId" method="post">
            <input type="hidden" name="archived" value="@((!isArchived).ToString())" />
            <button type="submit" class="btn btn-outline-danger">
                @(isArchived ? "Dezarhiveaza proiectul" : "Arhiveaza proiectul")
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
