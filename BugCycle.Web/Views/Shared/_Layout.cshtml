@using Microsoft.AspNetCore.Identity
@using BugCycle.Domain.Entities
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    var currentUser = SignInManager.IsSignedIn(User) ? await UserManager.GetUserAsync(User) : null;
    var isAdmin = User.IsInRole(AppRoles.Admin);
}

<!DOCTYPE html>
<html lang="ro">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BugCycle</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="app-header">
        <nav class="navbar navbar-expand-lg">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Dashboard" asp-action="Index">
                    <span class="brand-mark">BC</span>
                    <span class="brand-text">BugCycle</span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target="#mainNav" aria-controls="mainNav"
                        aria-expanded="false" aria-label="Comuta navigarea">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    @if (currentUser is not null)
                    {
                        <ul class="navbar-nav me-auto">
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Projects" asp-action="Index">Proiecte</a>
                            </li>
                            @if (isAdmin)
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" role="button"
                                       data-bs-toggle="dropdown" aria-expanded="false">Administrare</a>
                                    <ul class="dropdown-menu">
                                        <li>
                                            <a class="dropdown-item" asp-controller="Admin" asp-action="Users">
                                                Utilizatori si roluri
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Admin" asp-action="Labels">
                                                Etichete globale
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Admin" asp-action="Projects">
                                                Toate proiectele
                                            </a>
                                        </li>
                                    </ul>
                                </li>
                            }
                        </ul>

                        <div class="d-flex align-items-center gap-3">
                            <a class="user-chip" asp-controller="Account" asp-action="Profile">
                                <span class="avatar">@currentUser.Initials</span>
                                <span class="user-chip-text">
                                    <span class="user-chip-name">@currentUser.FullName</span>
                                    @if (isAdmin)
                                    {
                                        <span class="user-chip-role">Admin</span>
                                    }
                                </span>
                            </a>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                <button type="submit" class="btn btn-sm btn-outline-light">Iesi</button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <ul class="navbar-nav ms-auto">
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">Autentificare</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-sm btn-light ms-2" asp-controller="Account" asp-action="Register">
                                    Creeaza cont
                                </a>
                            </li>
                        </ul>
                    }
                </div>
            </div>
        </nav>
    </header>

    <main class="app-main">
        <div class="container-fluid">
            <partial name="_Alerts" />
            @RenderBody()
        </div>
    </main>

    <footer class="app-footer">
        <div class="container-fluid">
            BugCycle &mdash; urmarire de issue-uri, sprinturi si board kanban.
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
