@model EditIssueViewModel
@{
    ViewData["Title"] = $"Editare {Model.DisplayKey}";
}

<div class="form-shell">
    <div class="card-panel">
        <h1>Editeaza @Model.DisplayKey</h1>
        <p class="text-muted">In proiectul <strong>@Model.ProjectName</strong>.</p>

        <form asp-action="Edit" asp-route-id="@Model.IssueId" method="post" novalidate>
            <input type="hidden" name="projectId" value="@Model.ProjectId" />

            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="Input.Title" class="form-label">Titlu</label>
                    <input asp-for="Input.Title" class="form-control" />
                    <span asp-validation-for="Input.Title" class="field-error"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Input.Description" class="form-label">Descriere</label>
                    <textarea asp-for="Input.Description" class="form-control" rows="6"></textarea>
                    <span asp-validation-for="Input.Description" class="field-error"></span>
                </div>

                <div class="col-md-3">
                    <label asp-for="Input.Type" class="form-label">Tip</label>
                    <select asp-for="Input.Type" class="form-select">
                        @foreach (var type in Enum.GetValues<IssueType>())
                        {
                            <option value="@((int)type)">@Label(type)</option>
                        }
                    </select>
                </div>

                <div class="col-md-3">
                    <label asp-for="Input.Status" class="form-label">Status</label>
                    <select asp-for="Input.Status" class="form-select">
                        @foreach (var status in Enum.GetValues<IssueStatus>())
                        {
                            <option value="@((int)status)">@Label(status)</option>
                        }
                    </select>
                    <small class="form-hint">Done cere un assignee.</small>
                </div>

                <div class="col-md-3">
                    <label asp-for="Input.Priority" class="form-label">Prioritate</label>
                    <select asp-for="Input.Priority" class="form-select">
                        @foreach (var priority in Enum.GetValues<IssuePriority>())
                        {
                            <option value="@((int)priority)">@Label(priority)</option>
                        }
                    </select>
                </div>

                <div class="col-md-3">
                    <label asp-for="Input.StoryPoints" class="form-label">Story points</label>
                    <input asp-for="Input.StoryPoints" type="number"
                           min="0" max="100" class="form-control" />
                    <span asp-validation-for="Input.StoryPoints" class="field-error"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Input.AssigneeId" class="form-label">Asignat lui</label>
                    <select asp-for="Input.AssigneeId" class="form-select">
                        <option value="">neasignat</option>
                        @foreach (var user in Model.AssignableUsers)
                        {
                            <option value="@user.Id">@user.FullName</option>
                        }
                    </select>
                </div>

                <div class="col-md-6">
                    <label asp-for="Input.SprintId" class="form-label">Sprint</label>
                    <select asp-for="Input.SprintId" class="form-select">
                        <option value="">backlog</option>
                        @foreach (var sprint in Model.OpenSprints)
                        {
                            <option value="@sprint.Id">@sprint.Name (@Label(sprint.Status))</option>
                        }
                    </select>
                </div>

                <div class="col-12">
                    <label class="form-label">Etichete</label>
                    <div class="label-picker">
                        @foreach (var label in Model.Labels)
                        {
                            <label class="label-option">
                                <input type="checkbox" name="Input.LabelIds" value="@label.Id"
                                       checked="@Model.Input.LabelIds.Contains(label.Id)" />
                                <span class="label-chip" style="background-color:@label.ColorHex">
                                    @label.Name
                                </span>
                            </label>
                        }
                    </div>
                    <small class="form-hint">
                        Formularul trimite setul complet de etichete dorit, iar serverul
                        adauga ce lipseste si scoate ce nu mai este bifat.
                    </small>
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Salveaza</button>
                <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.IssueId">
                    Renunta
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
